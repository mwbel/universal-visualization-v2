    {
      "id": "adv_math.C12.S03.P023",
      "subject": "高等数学",
      "chapter": "第12章 微分方程",
      "section": "方程组",
      "label": "12.6",
      "title": "微分方程的简单应用",
      "details": "微分方程有着广泛的应用，用微分方程解决应用问题的一般步骤如下：\n\n(1) 分析问题的特点, 建立微分方程, 并提出定解条件;\n\n(2) 求出微分方程的通解;\n\n(3) 根据定解条件求出微分方程的特解\n\n可以用微分方程求解的应用问题包括几何问题、混合问题、电路问题、力学问题等.",
      "viz": {
        "viz_id": "geometry_viewer",
        "viz_desc": "几何可视化组件",
        "tech": [
